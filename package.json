{
  "name": "namya-astro-backend-customer",
  "version": "0.1.0",
  "description": "NamyaAstro customer backend: REST API + real-time sessions (NestJS, PostgreSQL, Redis, Socket.IO)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "smoke": "ts-node scripts/smoke.ts",
    "load": "ts-node scripts/load.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/platform-socket.io": "11.2.12",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/websockets": "11.2.12",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "agora-token": "2.0.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "firebase-admin": "13.10.0",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.12",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "dotenv": "16.6.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
