NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins for CORS / Socket.IO ("*" in dev)
CORS_ORIGINS=*

DATABASE_URL=postgresql://namya:namya@localhost:5432/namya?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP: "console" logs the code (dev, fixed code 123456), "msg91" sends a real SMS
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Razorpay (wallet top-ups). Leave empty in dev to use the mock gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Voice: Agora RTC. Leave empty in dev to get a placeholder token.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Push notifications: path to a Firebase service-account JSON, or empty to log only
FIREBASE_SERVICE_ACCOUNT_PATH=

# Time zone used for slots, "1 consultation per day" and horoscopes
APP_TIMEZONE=Asia/Kolkata

# Number of proxy hops in front of the API (load balancer) so rate limits see the real client IP
TRUST_PROXY=
# Only for local load/smoke tests
THROTTLE_DISABLED=false
